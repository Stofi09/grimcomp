# Root-owned /etc/grimcomp/api.env, mode 0640, group grimcomp.
# Node binary is installed separately at /opt/grimcomp/node/bin/node (Node 24).
# Keep this process and its SQLite state separate from HomeBase and David.
NODE_ENV=production
HOST=127.0.0.1
PORT=3030
DATABASE_PATH=/var/lib/grimcomp/grimcomp.sqlite
APP_ORIGINS=https://grimcomp.solak.hu
TRUSTED_PROXIES=127.0.0.1
# Sign-ups: closed (the production default), invite or open. With invite,
# share a private code (12-256 characters) such as `openssl rand -hex 16`.
# The code is compared in constant time and never logged.
REGISTRATION_MODE=closed
# REGISTRATION_MODE=invite
# REGISTRATION_INVITE_CODE=replace-with-a-private-random-code
# Capacity guards; size MAX_BACKUP_STORAGE_BYTES to the volume's budget.
MAX_ACCOUNTS=1000
MAX_BACKUP_STORAGE_BYTES=2147483648
# Native release builds separately require:
# EXPO_PUBLIC_API_URL=https://grimcomp.solak.hu
