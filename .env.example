# Backend settings (pnpm server reads .env automatically).
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./server/data/grimcomp.sqlite
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081
# Optional: exact IPs of reverse proxies you control. Empty ignores forwarded IPs.
# A proxy on this host might use TRUSTED_PROXIES=127.0.0.1,::1.
TRUSTED_PROXIES=

# Expo development: iOS simulator can use localhost. For a physical device,
# use this computer's LAN address and HOST=0.0.0.0 above.
# Android emulator normally uses http://10.0.2.2:3001.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Production: NODE_ENV=production, HTTPS APP_ORIGINS and EXPO_PUBLIC_API_URL,
# and DATABASE_PATH on a persistent volume. Never put secrets in EXPO_PUBLIC_*.
